rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kolekcja autoryzacji: zabraniamy masowego pobierania listy (list),
    // dozwolone jest jedynie odpytanie o konkretny dokument użytkownika (get) oraz zapis (create, update).
    match /autoryzacja_pin/{nazwisko} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;
    }

    // Pozostałe kolekcje aplikacji (grafik, obecności, gamifikacja, konfiguracja publiczna, nagrody)
    match /stan_grafiku/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /obecnosc/{document=**} {
      allow read, write: if true;
    }
    match /konfiguracja/{document=**} {
      allow read, write: if true;
    }
    match /gamifikacja/{document=**} {
      allow read, write: if true;
    }
    match /nagrody_miesieczne/{document=**} {
      allow read, write: if true;
    }
  }
}
